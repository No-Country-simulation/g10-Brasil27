# Copie este arquivo para .env e preencha somente na sua máquina.
# O .env nunca vai para o Git. Este arquivo vai, sempre sem valores.
# O código que lê estas variáveis precisa chamar load_dotenv() (python-dotenv) no início.

# LLM (provedor ainda a definir pela equipe)
LLM_API_KEY=

# OCI Object Storage (Always Free)
# Região: precisa ser a região home do tenancy usado no projeto (ex.: sa-saopaulo-1)
OCI_REGION=
# Namespace do Object Storage, exibido em Perfil > Tenancy no console da OCI
OCI_NAMESPACE=
# Nome do bucket (ex.: mediflow-documentos-clinicos)
OCI_BUCKET_NAME=

# Interface -> API
# Endereço da API FastAPI usado pela interface Streamlit (ex.: http://localhost:8000)
MEDIFLOW_API_URL=
